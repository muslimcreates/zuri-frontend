# Copy this file to .env and fill in real values. Vite only exposes
# variables prefixed VITE_ to the browser — don't put secrets here, this
# file ships to every visitor's browser.

# The backend API's base URL. Matches PORT in the backend's .env.
VITE_API_URL="http://localhost:4000"

# --- Google Sign-In ---
# The SAME Client ID you put in the backend's GOOGLE_CLIENT_ID (see the
# backend README "Setting up Google Sign-In" for how to create one in
# Google Cloud Console). This is the only Google credential the frontend
# needs — there is no client secret involved in this flow.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
